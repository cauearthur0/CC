# =============================================================================
# Checa Vídeo — configuração. Copie para .env (o `make dev` faz isso) e ajuste.
# Toda variável aqui é opcional, exceto ANTHROPIC_API_KEY para checagens reais.
# =============================================================================

# ---------------------------------------------------------------- IA (Anthropic)
# Chave da API. Fica só no backend (api/worker); nunca vai para o navegador.
ANTHROPIC_API_KEY=
# "anthropic" (real) ou "simulado" (sem rede, vereditos sorteados; só para testar a interface)
LLM_PROVEDOR=anthropic
# Modelo por etapa. Extração: limpar OCR e segmentar alegações (barato).
MODEL_EXTRACT=claude-sonnet-5-5
# Checagem com busca e redação do veredito (a etapa que mais pesa no custo).
MODEL_VERIFY=claude-opus-5-5
# Síntese: resumo, acertos, padrão da desinformação.
MODEL_SYNTHESIZE=claude-opus-5-5
# Esforço de raciocínio por etapa: low | medium | high | xhigh | max
EFFORT_EXTRACT=medium
EFFORT_VERIFY=medium
EFFORT_SYNTHESIZE=medium
# Se o modelo recusar por política, reexecuta no modelo indicado pela Anthropic ("default").
# Deixe vazio para desligar.
FALLBACKS=default
# Usa structured outputs (JSON garantido pelo servidor) na extração e na síntese.
USAR_STRUCTURED_OUTPUTS=true

# ---------------------------------------------------------------- busca na web
# Máximo de buscas por alegação (web search custa US$ 10 por 1.000 buscas).
WEB_SEARCH_MAX_USES=6
# Máximo de páginas abertas por alegação (web fetch; 0 desliga). Útil para ler leis e decisões.
WEB_FETCH_MAX_USES=3
WEB_FETCH_MAX_CONTENT_TOKENS=8000
# Domínios que a busca nunca deve usar, separados por vírgula. Ex.: sitedeboatos.com,outro.net
DOMINIOS_BLOQUEADOS=
# Quantos quadros em alta resolução o modelo pode pedir na extração ("ver melhor").
VER_QUADRO_MAX=3

# ---------------------------------------------------------------- custo
# Teto de gasto por checagem (US$). Ao chegar perto, as alegações restantes (as menos
# importantes) ficam "não verificadas" e isso aparece nas limitações do relatório.
ORCAMENTO_USD_POR_CHECAGEM=1.00
# Estimativa inicial do custo de checar uma alegação (recalibrada com o uso real da checagem).
CUSTO_ESTIMADO_POR_ALEGACAO_USD=0.20
# Reaproveita vereditos da mesma alegação (mesmo modelo e prompt) por N dias. 0 desliga.
CACHE_VEREDITOS_DIAS=7

# ---------------------------------------------------------------- Whisper (áudio)
# tiny | base | small | medium | large-v3 | desligado. "medium" é o equilíbrio em CPU.
WHISPER_MODELO=medium
# cpu | cuda | auto
WHISPER_DISPOSITIVO=cpu
# int8 em CPU; float16 em GPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_IDIOMA=pt
# Baixar o modelo já na construção da imagem Docker (ex.: medium). Vazio = baixa na 1ª checagem.
WHISPER_PRELOAD=

# ---------------------------------------------------------------- OCR
# Idioma do tesseract (pacote tesseract-ocr-<lang> precisa estar instalado).
TESSERACT_IDIOMA=por
# Pixel conta como texto de legenda se min(R,G,B) passar disto.
OCR_LIMIAR_BRANCO=225
# Quadros com menos pixels de máscara são considerados sem legenda.
OCR_MIN_PIXELS_MASCARA=150
# A faixa da legenda é procurada da altura (fração) até o fim do quadro. 0.45 = metade de baixo.
OCR_BUSCA_FAIXA_INICIO=0.45
# Processos de tesseract em paralelo.
OCR_THREADS=4

# ---------------------------------------------------------------- uploads e limites
MAX_UPLOAD_MB=200
MAX_DURACAO_S=600
FORMATOS_ACEITOS=mp4,mov,webm,m4v
# Novas checagens por IP por hora (0 desliga).
RATE_LIMIT_UPLOADS_POR_HORA=10
# Confia no X-Forwarded-For (deixe true atrás do proxy do Next ou de um balanceador).
CONFIAR_X_FORWARDED_FOR=true

# ---------------------------------------------------------------- infraestrutura
# Endereço público do site (entra no link do relatório, no PDF e no card).
URL_PUBLICA=http://localhost:3000
PORTA_WEB=3000
# SQLite por padrão; Postgres também funciona: postgresql+psycopg://usuario:senha@host/banco
# (no Docker, o padrão é sqlite:////dados/checa.db, num volume)
# DATABASE_URL=sqlite:///./dados/checa.db
# rq (Redis + worker) | inline (thread na própria API, sem Redis; só para dev)
# FILA=rq
# REDIS_URL=redis://localhost:6379/0
# local | s3 (experimental; requer boto3 e credenciais AWS no ambiente)
ARMAZENAMENTO=local
S3_BUCKET=
S3_PREFIXO=checa/
